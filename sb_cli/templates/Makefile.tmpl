# Makefile — generated by sb-cli for experiment: $experiment_name
# Kernel: $benchmark_name | Dataset: $dataset | Device: $device

FILE_PATH=torchscript.py
TRANSFORM_PATH=transform.mlir
SCRIPTS_DIR=../../../scripts
ODIR=output

TARGET=$target_path

all: $$(TARGET)

# Generate MLIR from Torch model
$$(ODIR)/01_tosa.mlir: $$(FILE_PATH)
	python $$< $$@ --dialect=tosa

# Put the transform schedule in the output directory where it is expected
$$(ODIR)/04_transform_sched.mlir: $$(TRANSFORM_PATH)
	cp $$< $$@

# Include the rules to generate linalg from a torch model translated to tosa
include $$(SCRIPTS_DIR)/mkinc/tosa_to_llvm.mk

# Include the rules to generate soda LLVM IR
include $$(SCRIPTS_DIR)/mkinc/soda_to_llvm.mk

# Include rules to generate verilog and simulate with Bambu
#  BAMBU_DEVICE and BAMBU_CLOCK_PERIOD can be overridden by env vars (set by flow.py)
BAMBU_DEVICE?=$device
BAMBU_CLOCK_PERIOD?=$clock_period

# Name of the baremetal application scripts/ll_to_riscv.sh stages for the esp
# backend. The experiment's logical name, not its timestamped directory, so two
# experiments dropped into the same ESP checkout stay distinguishable.
ESP_APP_NAME?=$experiment_name

# Instrumentation IP integration (empty unless an --instrumentation recipe was selected)
$ip_integration_block
include $$(SCRIPTS_DIR)/mkinc/llvm_to_verilog.mk

# Include rules to generate gds files with openroad
include $$(SCRIPTS_DIR)/mkinc/verilog_to_gds.mk

# Include rules for the cpu and esp backends. Like every include above, these only
# define rules -- nothing fires unless TARGET asks for one of their artifacts.
include $$(SCRIPTS_DIR)/mkinc/ll_to_binary.mk
include $$(SCRIPTS_DIR)/mkinc/ll_to_riscv.mk
