"""flow.py — generated by sb-cli for experiment: $experiment_name

Single source of truth for hardware configuration.
Run this file to execute the full synthesis flow.

Config:
    benchmark_name : $benchmark_name
    dataset        : $dataset
    dtype          : $dtype
    device         : $device
    clock_period   : $clock_period
    memory_policy  : $memory_policy
    flow           : $flow
    backend        : $backend
    stage          : $stage
    target         : $target_name -> $target_path
    instrumentation: $instrumentation

Usage:
    python flow.py
"""

from __future__ import annotations

import os
import subprocess
from pathlib import Path

_EXPERIMENT_DIR = Path(__file__).parent


class Flow:
    """Hardware synthesis flow configuration and runner."""

    benchmark_name: str | None = $benchmark_name_repr
    dataset: str = "$dataset"
    dtype: str = "$dtype"
    device: str = "$device"
    clock_period: float = $clock_period
    memory_policy: str = "$memory_policy"
    target: str = "$target_path"
    instrumentation: str = "$instrumentation"

    def run(self) -> None:
        """Set hardware env vars and invoke make targeting self.target."""
        env = os.environ.copy()
        env["BAMBU_DEVICE"] = self.device
        env["BAMBU_CLOCK_PERIOD"] = str(self.clock_period)
        if self.memory_policy:
            env["BAMBU_MEMPOLICY"] = self.memory_policy
        subprocess.run(
            ["make", f"TARGET={self.target}"],
            env=env,
            check=True,
            cwd=_EXPERIMENT_DIR,
        )


if __name__ == "__main__":
    Flow().run()
