#!/usr/bin/env python3
"""sc_flow.py — generated by sb-cli for experiment: $experiment_name

Config:
    benchmark_name : $benchmark_name
    dataset        : $dataset
    dtype          : $dtype
    device         : $device
    clock_period   : $clock_period
    memory_policy  : $memory_policy
    flow           : $flow
    backend        : $backend
    stage          : $stage
    instrumentation: $instrumentation

Generated on $created_at beside the Makefile, and an alternative
to it rather than a replacement: both build this experiment. This one hands the
MLIR front end, high-level synthesis and -- for the gds stage -- everything the
generated OpenROAD-flow-scripts config.mk used to drive to one SiliconCompiler
job, so there is no generated backend to keep in step. What goes away with it:
patch_openroad_synt.sh, the per-platform config.mk, the per-platform .sdc and
synthesize_Synthesis_<kernel>.sh. The target supplies the technology and the
design supplies the constraints.

Usage:
    ./sc_flow.py

The model export is the one the Makefile drives too, so either backend may run
it; this script runs it if output/01_tosa.mlir is not there yet:

    python torchscript.py
"""

import os
import os.path
import subprocess
import sys

from siliconcompiler import ASIC, Design
from siliconcompiler.flows.asicflow import ASICFlow
from siliconcompiler.flows.elaborationflow import ElaborationFlow
from siliconcompiler.flows.sodaflow import (
    SODABaselineElaborationFlow,
    SODAOptimizedElaborationFlow,
    SODATransformedElaborationFlow,
)
from siliconcompiler.targets import asap7_demo, freepdk45_demo
from siliconcompiler.tools.bambu.convert import ConvertTask as BambuConvertTask
from siliconcompiler.tools.soda.opt import TransformedTask

# --- What sb-cli chose ------------------------------------------------------
EXPERIMENT = "$experiment_name"
BENCHMARK = $benchmark_name_repr
# Recorded for provenance rather than read: the dataset is baked into the model
# torchscript.py exports, and the recipe into transform.mlir and IPs/.
DATASET = "$dataset"
INSTRUMENTATION = "$instrumentation"

# sb-cli's --flow, called STRATEGY here because a "flow" in SiliconCompiler is
# the whole graph of steps and this names only how soda-opt lowers the kernel.
STRATEGY = "$flow"
# How far to build: llvm, verilog, simulation or gds.
STAGE = "$stage"

DEVICE = "$device"
CLOCK_PERIOD = $clock_period
MEMORY_POLICY = "$memory_policy"

# Everything below is anchored at the experiment directory rather than at the
# working directory, so the same design is built from wherever this is run.
EXPERIMENT_DIR = os.path.dirname(os.path.abspath(__file__))
MODEL = "torchscript.py"
TOSA = os.path.join("output", "01_tosa.mlir")
SDC = "constraints.sdc"
SCHEDULE = "transform.mlir"

# soda-opt outlines the kernel it finds into <function>_kernel, and everything
# downstream -- bambu's --top-fname, synthesis, place-and-route -- is pointed at
# that name and not at the model's entry point.
TOP = "forward_kernel"

# The design is named after the kernel so that runs of one kernel share a build
# directory and the experiment name distinguishes the jobs inside it. A dotted
# --benchmark_name is a module path, whose last component is the kernel.
DESIGN = BENCHMARK.split(".")[-1] if BENCHMARK else EXPERIMENT

# Bambu's front-end compiler, pinned the way scripts/ll_to_verilog.sh pins it:
# the IR mlir-translate emits carries opaque pointers, which a bambu built
# against a clang older than 15 rejects. Empty leaves bambu on its own default.
BAMBU_COMPILER = "I386_CLANG16"

# Skip SiliconCompiler's check of each tool's version against the range in
# tool,<tool>,task,<task>,version. The container's soda-opt, bambu, yosys and
# openroad are built from source rather than installed from a release, so they
# report versions the tasks do not recognise and every node refuses to start.
#
# TODO: pin the versions instead of bypassing the check -- declare what the
# container actually ships in each task's `version`, then set this back to
# False so a tool that is genuinely too old is caught before it runs.
NOVERCHECK = True

# Bambu device to (SiliconCompiler target, one nanosecond in library units).
#
# The target carries the device bambu estimates against -- lambdapdk's nangate45
# says --device=nangate45 -- so the HLS estimate and the cells synthesis maps to
# cannot disagree, and there is no BAMBU_DEVICE to keep in step with a config.mk.
#
# The second element scales the SDC, which is read in the library's own time
# unit: asap7 works in picoseconds, which is why upstream's asap7_constraints.sdc
# states 5000 where nangate45_constraints.sdc states 5. SiliconCompiler scales it
# back to nanoseconds for bambu through the library's clock_multiplier.
TARGETS = {
    "nangate45": (freepdk45_demo, 1.0),
    "asap7": (asap7_demo, 1000.0),
}

# The strategy sb-cli names, and the SODA front-end flow that implements it.
# Each is handed to a downstream flow as its frontend=, which is how the MLIR
# path continues into the ordinary synthesis and place-and-route steps instead
# of into a backend of its own.
FRONTENDS = {
    "baseline": SODABaselineElaborationFlow,
    "optimized": SODAOptimizedElaborationFlow,
    "transformed": SODATransformedElaborationFlow,
}

# The corner suffix bambu takes (asap7-BC) is not part of the target's name --
# the same suffix sb_cli.flow.gds_platform() strips off the results directory.
PLATFORM = DEVICE.split("-")[0]


def export_model():
    """Runs the torch-mlir export, as the Makefile's 01_tosa.mlir rule does.

    torchscript.py takes no arguments: it writes ./output/01_tosa.mlir relative
    to the working directory, so it is run from the experiment directory.
    """
    if os.path.isfile(os.path.join(EXPERIMENT_DIR, TOSA)):
        return
    subprocess.run([sys.executable, MODEL], cwd=EXPERIMENT_DIR, check=True)


def write_constraints(unit):
    """Writes the clock constraint, replacing <platform>_constraints.sdc.

    Bambu names the clock port of the RTL it generates after the port this file
    creates its clock on, and the same file then constrains synthesis and
    place-and-route, so the period is stated once here instead of once in the
    Makefile, once in the bambu invocation and once per platform SDC.

    Args:
        unit: One nanosecond in the library's time unit. The SDC is read with
            the library, so an asap7 build states 5000 where a nangate45 one
            states 5 -- the whole difference between upstream's two platform
            SDC files.
    """
    path = os.path.join(EXPERIMENT_DIR, SDC)
    period = CLOCK_PERIOD * unit
    marker = f"# Generated by sb-cli for a {period} period.\n"
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as f:
            if f.readline() == marker:
                # Written for the period being asked for, so an edited SDC is
                # left alone. Delete it to have it written again.
                return
        # The period changed. The same file feeds high-level synthesis,
        # synthesis and place-and-route, so keeping the old one would quietly
        # hold all three to a number nobody asked for.
        print(f"[sc_flow] {SDC} was written for a different clock period; "
              f"rewriting it for {period}")
    io_delay = period * 0.2
    with open(path, "w", encoding="utf-8") as f:
        f.write(marker)
        f.write("create_clock [get_ports clock] -name core_clock "
                f"-period {period}\n")
        # The clock port is not an input to constrain, which is what upstream's
        # platform SDC filters out of all_inputs.
        f.write("set non_clock_inputs [lsearch -inline -all -not -exact "
                "[all_inputs] [get_ports clock]]\n")
        f.write(f"set_input_delay {io_delay} -clock core_clock "
                "$$non_clock_inputs\n")
        f.write(f"set_output_delay {io_delay} -clock core_clock "
                "[all_outputs]\n")


def build_design():
    """The design: the exported model plus the constraints it is built to.

    The fileset holding the model is named for what it holds, MLIR rather than
    RTL. Nothing keys off the name; the front end looks for a .mlir file across
    every fileset the project selected.
    """
    design = Design(DESIGN)
    design.set_dataroot("experiment", __file__)

    with design.active_dataroot("experiment"):
        with design.active_fileset("soda"):
            design.set_topmodule(TOP)
            design.add_file(TOSA)
        with design.active_fileset("sdc"):
            design.add_file(SDC)

    return design


def configure_ip(bambu):
    """Points high-level synthesis at the instrumentation IP, if there is any.

    sb-cli init --instrumentation <recipe> copies the recipe's IPs/ directory
    into the experiment verbatim, and sb-cli fork carries it along, so the
    directory already is the recipe's file list: module_lib.xml, the resource
    constraints, the Verilog of each component and the C stub that stands in for
    it during co-simulation. module_lib.h is read by that stub rather than by
    bambu, and is not passed to either backend.

    These are the same inputs ll_to_verilog.sh builds its IP_* variables from,
    set through the task's parameters rather than as raw options so that
    SiliconCompiler treats them as files: they are hashed into the node's cache
    key, so changing an IP re-runs high-level synthesis, and they are copied for
    a remote run.

    Args:
        bambu: The high-level synthesis task of the flow that was just set.
    """
    ips = os.path.join(EXPERIMENT_DIR, "IPs")
    if not os.path.isdir(ips):
        return

    def listed(ext):
        return sorted(os.path.join(ips, name) for name in os.listdir(ips)
                      if name.endswith(ext))

    found = False

    technology = os.path.join(ips, "module_lib.xml")
    if os.path.isfile(technology):
        bambu.set_bambu_technologyfile(technology)
        found = True

    constraints = os.path.join(ips, "constraints_STD.xml")
    if os.path.isfile(constraints):
        bambu.set_bambu_constraintsfile(constraints)
        found = True

    excluded = listed(".c")
    if excluded:
        bambu.add_bambu_cnoparse(excluded)
        found = True

    verilog = listed(".v")
    if verilog:
        bambu.add_bambu_fileinputdata(verilog)
        found = True

    if found:
        # --generate-components-library, without which the components bound in
        # from the technology XML do not resolve.
        bambu.set_bambu_componentslibrary(True)


def configure(project):
    """Applies the settings the Makefile passed as BAMBU_* variables.

    Task settings are per task, so this runs once the flow has put the tasks
    into the project, which is what makes them reachable by find_task from here
    without the flow having to pass anything through.

    Args:
        project: The project whose flow was just selected.
    """
    if STRATEGY == "transformed":
        # sb-cli writes transform.mlir into the experiment directory, either the
        # instrumentation recipe's schedule or a no-op one. Upstream copies it to
        # output/04_transform_sched.mlir where the soda_to_llvm rules expect it;
        # here the task holds the path, and the file is hashed into the node's
        # cache key, so editing the schedule re-runs the lowering.
        TransformedTask.find_task(project).set_soda_schedule(
            os.path.join(EXPERIMENT_DIR, SCHEDULE))

    bambu = BambuConvertTask.find_task(project)
    if MEMORY_POLICY:
        # --memory_policy defaults to empty, which leaves each backend on its
        # own default. Both default to NO_BRAM, so an unset policy still means
        # the same thing on either side.
        bambu.set_bambu_memorypolicy(MEMORY_POLICY)
    bambu.set_bambu_memorychannels(2)
    bambu.set_bambu_experimentalsetup("BAMBU-BALANCED-MP")
    if BAMBU_COMPILER:
        bambu.set_bambu_compiler(BAMBU_COMPILER)
    # The C testbench soda-opt emits reaches this node over the flow, so the
    # simulation stage needs nothing but the switch. The rest of what
    # ll_to_verilog.sh spells out -- -lm, --soft-float, --disable-function-proxy,
    # --simulator, --verilator-parallel, --clock-period, --clock-name, --device
    # and --top-fname -- the task emits on its own.
    bambu.set_bambu_simulate(STAGE == "simulation")

    configure_ip(bambu)


def report_device(project):
    """Says so when the target estimates against another corner than was asked.

    The device bambu estimates against comes from the target's main library
    rather than from a variable, which is what keeps it in step with the cells
    synthesis maps to. The cost is that a corner sb-cli names but the target
    does not carry -- asap7_demo pins asap7-WC -- is not honoured, and reporting
    another corner's numbers silently is worse than saying so.

    Args:
        project: The project the target has been applied to.
    """
    mainlib = project.get("asic", "mainlib")
    library = project.get("library", mainlib, field="schema")
    if not library.valid("tool", "bambu", "device"):
        return
    device = library.get("tool", "bambu", "device")
    if device and device != DEVICE:
        print(f"[sc_flow] note: {mainlib} estimates against {device}, not "
              f"the requested {DEVICE}")


def main():
    if PLATFORM not in TARGETS:
        raise SystemExit(f"no SiliconCompiler target for device {DEVICE}; "
                         "add one to TARGETS")
    if STRATEGY not in FRONTENDS:
        raise SystemExit(f"no SODA front end for flow {STRATEGY}; this "
                         f"template knows {', '.join(sorted(FRONTENDS))}")

    target, unit = TARGETS[PLATFORM]

    export_model()
    write_constraints(unit)

    project = ASIC(build_design())
    project.add_fileset(["soda", "sdc"])

    target(project)
    report_device(project)

    frontend = FRONTENDS[STRATEGY]()
    if STAGE == "gds":
        # Everything downstream of bambu, which upstream is a generated
        # config.mk handed to OpenROAD-flow-scripts, is this one flow.
        project.set_flow(ASICFlow(frontend=frontend))
    else:
        project.set_flow(ElaborationFlow(frontend=frontend))
        if STAGE == "llvm":
            # The LLVM IR is the artifact, so stop before high-level synthesis.
            # link is the last node carrying it, and its output is upstream's
            # output/05_llvm_<flow>.ll.
            project.option.set("to", ["link"])

    # One job per experiment, so a fork's results sit beside the original's
    # instead of overwriting them.
    project.option.set_jobname(EXPERIMENT)

    if NOVERCHECK:
        # Global rather than per (step, index): every tool in the flow is a
        # source build here, so scoping it to one step would only move the
        # failure to the next node.
        project.option.set_novercheck(True)

    configure(project)

    project.run()
    project.summary()

    return project


if __name__ == "__main__":
    main()
