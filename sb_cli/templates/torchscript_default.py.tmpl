"""torchscript.py — generated by sb-cli (default matrix multiply template)

Generates output/01_tosa.mlir from a simple stateless matrix multiply model.
Edit this file to use your own model.

Usage:
    python torchscript.py
"""

import os

import torch
from torch_mlir import torchscript

OUT_PATH = "./output/01_tosa.mlir"


class MM(torch.nn.Module):
    """Stateless matrix multiply: returns torch.matmul(input1, input2)."""

    def forward(self, input1: torch.Tensor, input2: torch.Tensor) -> torch.Tensor:
        return torch.matmul(input1, input2)


def main() -> None:
    model = MM()

    # Input dimensions for matrix multiplication: [bs, M, K] x [bs, K, N]
    bs, M, K, N = 1, 4, 8, 4
    input1 = torch.randn(bs, M, K)
    input2 = torch.randn(bs, K, N)

    os.makedirs(os.path.dirname(OUT_PATH), exist_ok=True)
    module = torchscript.compile(model, (input1, input2), output_type="tosa", use_tracing=True)
    with open(OUT_PATH, "w", encoding="utf-8") as f:
        f.write(str(module))
    print(f"MLIR written to {OUT_PATH}")


if __name__ == "__main__":
    main()
