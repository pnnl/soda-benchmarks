"""torchscript.py — generated by sb-cli for $benchmark_name

Generates output/01_tosa.mlir from the $benchmark_name kernel.
Dataset: $dataset, Dtype: $dtype

Usage:
    python torchscript.py
"""

import os
import sys

# Ensure PolyBenchPyTorch is importable
_BENCH_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "../../.."))
if _BENCH_ROOT not in sys.path:
    sys.path.insert(0, _BENCH_ROOT)

from $kernel_module import $kernel_class, init_array  # noqa: E402
from PolyBenchPyTorch.linear_algebra.utils import (  # noqa: E402
    generate_mlir,
    get_dataset_dimensions,
    resolve_dtype,
)

OUT_PATH = "./output/01_tosa.mlir"


def main() -> None:
    dims = get_dataset_dimensions("$kernel_name", "$dataset")
    dtype = resolve_dtype("$dtype")
    model = $kernel_class(**dims)
    inputs = init_array(**dims, dtype=dtype)
    os.makedirs(os.path.dirname(OUT_PATH), exist_ok=True)
    generate_mlir(model, inputs, OUT_PATH, dialect="tosa")


if __name__ == "__main__":
    main()
