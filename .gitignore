#==============================================================================#
# File extensions to be ignored anywhere in the tree.
#==============================================================================#
# Temp files created by most text editors.
*~
# Merge files created by git.
*.orig
# Byte compiled python modules.
*.pyc
# vim swap files
.*.sw?
.sw?
#OS X specific files.
.DS_store

# Nested build directory
/build
/builds

# Nested tools
/external

# Python enviroments
.venv/
.venv*/

# core dumps
core

# Python caches
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
*.egg-info/

# pixi environments
.pixi/*
!.pixi/config.toml

# mkdocs build output
/site

# Temps (sb-cli generated experiment dirs; keep the registry + its own
# .gitignore tracked)
benches/experiments/*
!benches/experiments/registry.py
!benches/experiments/.gitignore
/experiments

# Vendored upstream reference, not tracked here (see benches/README.md)
benches/PolyBenchC-4.2.1

# Spec-kit artifacts
/.specs

# Generated MLIR output from kernel test runs
benches/PolyBenchPyTorch/**/output/

papers/
